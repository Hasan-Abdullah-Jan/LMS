# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated allow-list of browser origins that may call the API.
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase (Project Settings -> API) ------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server only. NEVER expose this key to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth -----------------------------------------------------------------
# Where password-reset emails send users. Must be listed in Supabase
# Auth -> URL Configuration -> Redirect URLs.
PASSWORD_RESET_REDIRECT=http://localhost:5173/reset-password
# Refresh-token cookie SameSite policy: "lax" when web and API share a site
# (local dev, single Render service, Vercel rewrite), "none" for cross-site.
COOKIE_SAMESITE=lax

# --- Optional -------------------------------------------------------------
# Serve the built React app (apps/web/dist) from the API (single-service deploy).
SERVE_WEB=false
LOG_LEVEL=info
