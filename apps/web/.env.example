# Base URL of the Express API. Use "/api" when the API serves the web app or
# when a Vercel rewrite proxies /api to the API host.
VITE_API_URL=http://localhost:4000/api
# Public Supabase settings (used ONLY for Realtime subscriptions).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
