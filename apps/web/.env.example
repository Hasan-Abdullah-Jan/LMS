# Base URL of the Express API.
#  - "/api" for local dev (Vite proxies /api -> http://localhost:4000), for the
#    single-service Render deploy, and for Vercel with the /api rewrite.
#  - A full URL (https://your-api.onrender.com/api) if the API is on another site.
VITE_API_URL=/api
# Public Supabase settings (used ONLY for Realtime subscriptions).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
