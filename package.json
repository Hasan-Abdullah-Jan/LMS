{
  "name": "gutech-lms-portal",
  "version": "1.0.0",
  "private": true,
  "description": "GUTECH LMS Portal - full-stack student/faculty learning management system (React + Node.js + Supabase).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build",
    "start": "npm --workspace apps/api run start",
    "test": "npm --workspace apps/api run test && npm --workspace apps/web run test",
    "test:e2e": "playwright test",
    "typecheck": "npm --workspace apps/api run typecheck && npm --workspace apps/web run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --include-seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "supabase": "^2.122.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
